    {
      "type": "timeseries",
      "title": "Pending backlog over time",
      "description": "Is the packing backlog growing or draining? Shipments still PENDING at the end of each bucket (created_at <= t and not yet shipped at t).",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.time, SUM(IF(s.created_at < FROM_UNIXTIME(t.time + $__interval_ms / 1000)\n                    AND (s.shipped_at IS NULL OR s.shipped_at >= FROM_UNIXTIME(t.time + $__interval_ms / 1000)), 1, 0)) AS pending\nFROM (\n  SELECT DISTINCT $__timeGroup(s0.created_at, $__interval) AS time\n  FROM shipments s0\n  WHERE $__timeFilter(s0.created_at) AND s0.deleted_at IS NULL\n) t\nCROSS JOIN shipments s\nWHERE s.deleted_at IS NULL\nGROUP BY t.time\nORDER BY t.time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }

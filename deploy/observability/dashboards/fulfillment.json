          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.5) AS tts_p50\nFROM shipments s\nWHERE $__timeFilter(s.shipped_at) AND s.deleted_at IS NULL AND s.shipped_at IS NOT NULL"

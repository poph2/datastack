    {
      "type": "timeseries",
      "title": "VIP SLA over time: p95 time to ship by tier",
      "description": "Does the VIP SLA hold up under load? p95 of shipped_at - created_at per loyalty tier and bucket.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(s.shipped_at, $__interval), COALESCE(c.loyalty_tier, 'UNKNOWN') AS metric,\n       PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.95) AS p95\nFROM shipments s\nJOIN orders o ON o.id = s.order_id AND o.deleted_at IS NULL\nLEFT JOIN customers c ON c.id = o.user_id AND c.deleted_at IS NULL\nWHERE $__timeFilter(s.shipped_at) AND s.deleted_at IS NULL AND s.shipped_at IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]

    {
      "type": "barchart",
      "title": "VIP SLA: time to ship by loyalty tier",
      "description": "Are GOLD customers' boxes really packed faster? p50/p95 time-to-ship by customers.loyalty_tier (shipments.order_id = orders.id, orders.user_id = customers.id), for boxes shipped in the range.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(c.loyalty_tier, 'UNKNOWN') AS tier,\n       PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.5) AS p50,\n       PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.95) AS p95\nFROM shipments s\nJOIN orders o ON o.id = s.order_id AND o.deleted_at IS NULL\nLEFT JOIN customers c ON c.id = o.user_id AND c.deleted_at IS NULL\nWHERE $__timeFilter(s.shipped_at) AND s.deleted_at IS NULL AND s.shipped_at IS NOT NULL\nGROUP BY 1\nORDER BY CASE tier WHEN 'GOLD' THEN 1 WHEN 'SILVER' THEN 2 WHEN 'BRONZE' THEN 3 ELSE 4 END"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },

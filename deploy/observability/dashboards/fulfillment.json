    {
      "type": "timeseries",
      "title": "Time to ship p50 / p95",
      "description": "Is fulfillment getting slower? Percentiles of shipped_at - created_at for shipments shipped in each bucket.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(s.shipped_at, $__interval),\n       PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.5) AS p50,\n       PERCENTILE_APPROX(TIMESTAMPDIFF(MILLISECOND, s.created_at, s.shipped_at) / 1000, 0.95) AS p95\nFROM shipments s\nWHERE $__timeFilter(s.shipped_at) AND s.deleted_at IS NULL AND s.shipped_at IS NOT NULL\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }

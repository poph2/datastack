            },
            "properties": [
              {
                "id": "displayName",
                "value": "Newest updated_at (UTC)"
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seconds_since_update"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Seconds since newest update"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {

    {
      "type": "table",
      "title": "Analytics tables in StarRocks",
      "description": "What has landed in analytics_db? Live and soft-deleted row counts per table, newest updated_at, and how many seconds ago that was (end-to-end freshness seen from StarRocks; quiet tables such as campaigns are naturally old).",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 'customers' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM customers UNION ALL\nSELECT 'campaigns' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM campaigns UNION ALL\nSELECT 'attributions' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM attributions UNION ALL\nSELECT 'inventory' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM inventory UNION ALL\nSELECT 'payments' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM payments UNION ALL\nSELECT 'shipments' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM shipments UNION ALL\nSELECT 'orders' AS table_name, SUM(IF(deleted_at IS NULL, 1, 0)) AS live_rows, SUM(IF(deleted_at IS NULL, 0, 1)) AS deleted_rows, MAX(updated_at) AS last_updated_at, TIMESTAMPDIFF(SECOND, MAX(updated_at), UTC_TIMESTAMP()) AS seconds_since_update FROM orders"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {

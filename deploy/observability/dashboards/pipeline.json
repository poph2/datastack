        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(cdc_lag_seconds)",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false

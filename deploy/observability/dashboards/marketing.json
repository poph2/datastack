          "editorMode": "code",
          "rawSql": "SELECT SUM(IF(a.order_id IS NOT NULL, 1, 0)) / NULLIF(COUNT(*), 0) AS conversion_rate\nFROM attributions a\nWHERE $__timeFilter(a.created_at) AND a.deleted_at IS NULL"

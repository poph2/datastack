    {
      "type": "stat",
      "title": "Attributed cleared revenue",
      "description": "How much paid revenue did campaigns drive in the range? Revenue is cleared revenue: attributions joined to payments on order_id with payments.status = 'SUCCESS'. attributions.order_amount is what the Order Service reported at conversion; the payment row is the money that actually cleared and stops counting if it is ever refunded.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(SUM(p.amount), 0) AS revenue\nFROM attributions a\nJOIN payments p ON p.order_id = a.order_id AND p.status = 'SUCCESS' AND p.deleted_at IS NULL\nWHERE $__timeFilter(a.converted_at) AND a.deleted_at IS NULL AND a.order_id IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "currencyUSD",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4,

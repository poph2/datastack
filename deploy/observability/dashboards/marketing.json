    {
      "type": "barchart",
      "title": "CAC by source (lifetime)",
      "description": "What does it cost to win one paying customer per channel? Sum of ad_spend / distinct converted users with cleared payments. $0-spend channels show $0.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.utm_source AS source, SUM(c.ad_spend) / NULLIF(MAX(r.buyers), 0) AS cac\nFROM campaigns c\nLEFT JOIN (\n  SELECT utm_source, COUNT(DISTINCT user_id) AS buyers FROM (\nSELECT a.utm_source, a.utm_campaign, a.user_id, a.order_id, p.amount\nFROM attributions a\nJOIN payments p ON p.order_id = a.order_id AND p.status = 'SUCCESS' AND p.deleted_at IS NULL\nWHERE a.deleted_at IS NULL AND a.order_id IS NOT NULL) x GROUP BY 1\n) r ON r.utm_source = c.utm_source\nWHERE c.deleted_at IS NULL\nGROUP BY c.utm_source\nORDER BY cac DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {

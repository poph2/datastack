    {
      "type": "table",
      "title": "Campaign ROI: ROAS and CAC (lifetime)",
      "description": "Which campaigns pay back their spend? Per (utm_source, utm_campaign): clicks, conversions, cleared revenue, ad_spend, ROAS = cleared revenue / ad_spend, CAC = ad_spend / distinct converted users. Campaigns with $0 spend show ROAS as ∞ and CAC as $0. Lifetime, because ad_spend is a lifetime total. Revenue is cleared revenue: attributions joined to payments on order_id with payments.status = 'SUCCESS'. attributions.order_amount is what the Order Service reported at conversion; the payment row is the money that actually cleared and stops counting if it is ever refunded.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.utm_source, c.utm_campaign,\n       COALESCE(k.clicks, 0) AS clicks,\n       COALESCE(k.conversions, 0) AS conversions,\n       COALESCE(k.conversions, 0) / NULLIF(k.clicks, 0) AS conversion_rate,\n       COALESCE(r.revenue, 0) AS cleared_revenue,\n       c.ad_spend,\n       IF(c.ad_spend = 0, NULL, COALESCE(r.revenue, 0) / c.ad_spend) AS roas,\n       c.ad_spend / NULLIF(r.buyers, 0) AS cac\nFROM campaigns c\nLEFT JOIN (\n  SELECT utm_source, utm_campaign, COUNT(*) AS clicks, SUM(IF(order_id IS NOT NULL, 1, 0)) AS conversions\n  FROM attributions WHERE deleted_at IS NULL GROUP BY 1, 2\n) k ON k.utm_source = c.utm_source AND k.utm_campaign = c.utm_campaign\nLEFT JOIN (\n  SELECT utm_source, utm_campaign, SUM(amount) AS revenue, COUNT(DISTINCT user_id) AS buyers\n  FROM (\nSELECT a.utm_source, a.utm_campaign, a.user_id, a.order_id, p.amount\nFROM attributions a\nJOIN payments p ON p.order_id = a.order_id AND p.status = 'SUCCESS' AND p.deleted_at IS NULL\nWHERE a.deleted_at IS NULL AND a.order_id IS NOT NULL) x GROUP BY 1, 2\n) r ON r.utm_source = c.utm_source AND r.utm_campaign = c.utm_campaign\nWHERE c.deleted_at IS NULL\nORDER BY cleared_revenue DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "utm_source"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source"
              }
            ]
          },
          {

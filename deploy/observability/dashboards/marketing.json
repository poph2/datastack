        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "barchart",
      "title": "Cleared revenue by channel",
      "description": "Which channel (utm_source) drives paid revenue in the range? Revenue is cleared revenue: attributions joined to payments on order_id with payments.status = 'SUCCESS'. attributions.order_amount is what the Order Service reported at conversion; the payment row is the money that actually cleared and stops counting if it is ever refunded.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.utm_source AS channel, SUM(p.amount) AS revenue\nFROM attributions a\nJOIN payments p ON p.order_id = a.order_id AND p.status = 'SUCCESS' AND p.deleted_at IS NULL\nWHERE $__timeFilter(a.converted_at) AND a.deleted_at IS NULL AND a.order_id IS NOT NULL\nGROUP BY 1\nORDER BY revenue DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {

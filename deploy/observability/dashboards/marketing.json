        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Blended ROAS (lifetime)",
      "description": "Is paid marketing profitable overall? Lifetime cleared revenue from paid channels / total ad_spend. Lifetime because ad_spend is a campaign total, not a time series. Revenue is cleared revenue: attributions joined to payments on order_id with payments.status = 'SUCCESS'. attributions.order_amount is what the Order Service reported at conversion; the payment row is the money that actually cleared and stops counting if it is ever refunded.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT SUM(r.revenue) / NULLIF(SUM(c.ad_spend), 0) AS roas\nFROM campaigns c\nLEFT JOIN (\n  SELECT utm_source, utm_campaign, SUM(amount) AS revenue FROM (\nSELECT a.utm_source, a.utm_campaign, a.user_id, a.order_id, p.amount\nFROM attributions a\nJOIN payments p ON p.order_id = a.order_id AND p.status = 'SUCCESS' AND p.deleted_at IS NULL\nWHERE a.deleted_at IS NULL AND a.order_id IS NOT NULL) x GROUP BY 1, 2\n) r ON r.utm_source = c.utm_source AND r.utm_campaign = c.utm_campaign\nWHERE c.deleted_at IS NULL AND c.ad_spend > 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },

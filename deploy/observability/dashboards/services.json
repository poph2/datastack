{
  "id": null,
  "uid": "datastack-services",
  "title": "DataStack / Services (RED + domain metrics)",
  "description": "Per-service request rate, errors and latency from the shared http_server_* / http_client_* metrics, plus each service's domain metrics.",
  "tags": [
    "datastack",
    "prometheus",
    "services"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",

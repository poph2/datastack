          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT i.product_id, i.category, i.stock_level, i.price,\n       IF(i.auto_restock, 'Yes', 'No') AS auto_restock\nFROM inventory i\nWHERE i.deleted_at IS NULL\nORDER BY i.stock_level ASC, i.product_id\nLIMIT 20"

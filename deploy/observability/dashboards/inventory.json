    {
      "type": "barchart",
      "title": "Revenue by category",
      "description": "Which categories make the money? PAID and SHIPPED order revenue by inventory.category (orders.product_id = inventory.product_id).",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT i.category, SUM(o.total_amount) AS revenue\nFROM orders o\nJOIN inventory i ON i.product_id = o.product_id AND i.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status IN ('PAID','SHIPPED')\nGROUP BY i.category\nORDER BY revenue DESC"

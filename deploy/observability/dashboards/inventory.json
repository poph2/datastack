          "rawSql": "SELECT COUNT(*) AS oos_failures FROM orders o\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status = 'FAILED' AND o.failure_reason = 'OUT_OF_STOCK'"

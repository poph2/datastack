          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(o.created_at, $__interval), SUM(o.quantity * i.price) * 60000 / $__interval_ms AS lost_per_min\nFROM orders o\nJOIN inventory i ON i.product_id = o.product_id AND i.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status = 'FAILED' AND o.failure_reason = 'OUT_OF_STOCK'\nGROUP BY 1\nORDER BY 1"

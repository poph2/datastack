    {
      "type": "timeseries",
      "title": "Lost revenue per minute",
      "description": "How fast are stock-outs costing us money? Lost revenue = quantity x current inventory.price for orders that FAILED with OUT_OF_STOCK (orders.product_id = inventory.product_id).",

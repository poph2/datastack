          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT o.product_id, i.category, SUM(o.quantity) AS units, SUM(o.total_amount) AS revenue,\n       MAX(i.stock_level) AS stock_now\nFROM orders o\nJOIN inventory i ON i.product_id = o.product_id AND i.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status IN ('PAID','SHIPPED')\nGROUP BY o.product_id, i.category\nORDER BY revenue DESC\nLIMIT 15"
        }

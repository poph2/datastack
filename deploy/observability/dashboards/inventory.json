    {
      "type": "table",
      "title": "Lost revenue by product",
      "description": "Which empty SKUs cost the most in the range? Lost revenue = quantity x current inventory.price for orders that FAILED with OUT_OF_STOCK (orders.product_id = inventory.product_id).",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT o.product_id, i.category, COUNT(*) AS failed_orders, SUM(o.quantity) AS units,\n       SUM(o.quantity * i.price) AS lost_revenue, MAX(i.stock_level) AS stock_now\nFROM orders o\nJOIN inventory i ON i.product_id = o.product_id AND i.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status = 'FAILED' AND o.failure_reason = 'OUT_OF_STOCK'\nGROUP BY o.product_id, i.category\nORDER BY lost_revenue DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {

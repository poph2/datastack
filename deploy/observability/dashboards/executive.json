    {
      "type": "barchart",
      "title": "Failure reasons: count and value",
      "description": "Where does the business lose checkouts? Failed orders by failure_reason, with the order value where it was known at failure time (total_amount is only set once inventory quoted a price, so OUT_OF_STOCK / customer failures show $0 here; see the Inventory dashboard for lost revenue).",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT o.failure_reason AS reason, COUNT(*) AS failed_orders,\n       COALESCE(SUM(o.total_amount), 0) AS known_value\nFROM orders o\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status = 'FAILED'\nGROUP BY o.failure_reason\nORDER BY failed_orders DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed_orders"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Failed orders"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "known_value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "displayName",
                "value": "Known order value"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }

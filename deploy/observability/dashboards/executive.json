    {
      "type": "stat",
      "title": "Checkout success rate",
      "description": "What share of checkouts ended SHIPPED? SHIPPED orders / all orders created in the range.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT SUM(IF(o.status = 'SHIPPED', 1, 0)) / NULLIF(COUNT(*), 0) AS success_rate\nFROM orders o\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL"

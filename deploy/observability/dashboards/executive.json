    {
      "type": "barchart",
      "title": "Revenue by country (top 15)",
      "description": "Which markets generate the money? PAID and SHIPPED revenue by customers.country (orders.user_id = customers.id). Orders whose customer row is gone show as UNKNOWN.",
      "datasource": {
        "type": "mysql",
        "uid": "starrocks"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "starrocks"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(c.country, 'UNKNOWN') AS country, SUM(o.total_amount) AS revenue\nFROM orders o\nLEFT JOIN customers c ON c.id = o.user_id AND c.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status IN ('PAID','SHIPPED')\nGROUP BY 1\nORDER BY revenue DESC\nLIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },

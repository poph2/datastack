          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(c.loyalty_tier, 'UNKNOWN') AS tier, SUM(o.total_amount) AS revenue,\n       AVG(o.total_amount) AS aov\nFROM orders o\nLEFT JOIN customers c ON c.id = o.user_id AND c.deleted_at IS NULL\nWHERE $__timeFilter(o.created_at) AND o.deleted_at IS NULL AND o.status IN ('PAID','SHIPPED')\nGROUP BY 1\nORDER BY CASE tier WHEN 'GOLD' THEN 1 WHEN 'SILVER' THEN 2 WHEN 'BRONZE' THEN 3 ELSE 4 END"
        }
